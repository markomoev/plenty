# Points the CMS SectionSlot fetcher (src/lib/sections/client.ts) at the
# admin app's public read API. Local dev → local admin app; production
# should point at the deployed admin app's URL.
ADMIN_API_URL=

# Origin of the admin app allowed to iframe this site and drive the live
# preview bridge (src/lib/preview/*) over postMessage, e.g.
# https://admin.plentybg.com. Leave empty to disable preview entirely —
# next.config.ts then locks frame-ancestors to 'self'.
NEXT_PUBLIC_ADMIN_ORIGIN=
